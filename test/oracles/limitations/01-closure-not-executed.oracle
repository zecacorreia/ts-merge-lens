# KNOWN FALSE NEGATIVE: a write inside a callback is not modelled; the closure is counted.
--- expect
{"alerts":[],"limitations":["closure"]}
--- base
export function run(): number {
  let x = 0;
  const a = 1;
  const b = 2;
  return a + b;
}
--- left
export function run(): number {
  let x = 0;
  const f = (): void => {
    x = 1;
  };
  const a = 1;
  const b = 2;
  return a + b;
}
--- right
export function run(): number {
  let x = 0;
  const a = 1;
  const b = 2;
  x = 2;
  return a + b;
}
