# KNOWN FALSE NEGATIVE: eval can write anything; the call is counted.
--- expect
{"alerts":[],"limitations":["eval"]}
--- base
export function run(): number {
  let x = 0;
  const a = 1;
  const b = 2;
  return a + b;
}
--- left
export function run(): number {
  let x = 0;
  eval("x = 1");
  const a = 1;
  const b = 2;
  return a + b;
}
--- right
export function run(): number {
  let x = 0;
  const a = 1;
  const b = 2;
  x = 2;
  return a + b;
}
