# Left writes in the right operand of && (may execute); Right writes afterwards.
--- expect
{"alerts":[{"element":"x","first":"Left run","second":"Right run"}]}
--- base
export function run(): number {
  let x = 0;
  const a = 1;
  const b = 2;
  return a + b;
}
--- left
export function run(): number {
  let x = 0;
  a > 0 && (x = 1);
  const a = 1;
  const b = 2;
  return a + b;
}
--- right
export function run(): number {
  let x = 0;
  const a = 1;
  const b = 2;
  x = 2;
  return a + b;
}
