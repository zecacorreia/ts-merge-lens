# The callees live in another module and write an imported object.
--- expect
{"alerts":[{"element":"store.value","first":"Left setA","second":"Right setB"}]}
--- base
import { setA, setB } from "./store";
export function run(): number {
  const a = 1;
  const b = 2;
  return a + b;
}
--- left
import { setA, setB } from "./store";
export function run(): number {
  setA();
  const a = 1;
  const b = 2;
  return a + b;
}
--- right
import { setA, setB } from "./store";
export function run(): number {
  const a = 1;
  const b = 2;
  setB();
  return a + b;
}
--- base src/store.ts
export const store = { value: 0 };
export function setA(): void {
  store.value = 1;
}
export function setB(): void {
  store.value = 2;
}
