# Left writes in a switch case; Right writes after the switch.
--- expect
{"alerts":[{"element":"x","first":"Left run","second":"Right run"}]}
--- base
export function run(): number {
  let x = 0;
  const a = 1;
  const b = 2;
  return a + b;
}
--- left
export function run(): number {
  let x = 0;
  switch (a) {
    case 1:
      x = 1;
      break;
    default:
      break;
  }
  const a = 1;
  const b = 2;
  return a + b;
}
--- right
export function run(): number {
  let x = 0;
  const a = 1;
  const b = 2;
  x = 2;
  return a + b;
}
