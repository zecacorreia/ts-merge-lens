# Left accumulates with += and Right then assigns the variable.
--- expect
{"alerts":[{"element":"total","first":"Left run","second":"Right run"}]}
--- base
export function run(): number {
  let total = 0;
  const a = 1;
  const b = 2;
  return a + b;
}
--- left
export function run(): number {
  let total = 0;
  total += 1;
  const a = 1;
  const b = 2;
  return a + b;
}
--- right
export function run(): number {
  let total = 0;
  const a = 1;
  const b = 2;
  total = 5;
  return a + b;
}
