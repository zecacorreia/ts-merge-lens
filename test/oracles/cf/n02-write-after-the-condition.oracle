# Left writes x only after the condition has been evaluated.
--- expect
{"analyses":["cf"],"alerts":[]}
--- base
export function run(): number {
  let x = 0;
  if (x > 0) {
    const b = 2;
  }
  const a = 1;
  return a;
}
--- left
export function run(): number {
  let x = 0;
  if (x > 0) {
    const b = 2;
  }
  const a = 1;
  x = 1;
  return a;
}
--- right
export function run(): number {
  let x = 0;
  if (x > 0) {
    const b = 2;
    void b;
  }
  const a = 1;
  return a;
}
