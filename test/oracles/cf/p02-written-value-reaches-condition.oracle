# Left writes x, which an unchanged condition reads; Right changed code runs under it.
--- expect
{"analyses":["cf"],"alerts":[{"type":"CF","element":"x","first":"Left run","second":"Right run"}]}
--- base
export function run(): number {
  let x = 0;
  const a = 1;
  if (x > 0) {
    const b = 2;
  }
  return a;
}
--- left
export function run(): number {
  let x = 0;
  x = 1;
  const a = 1;
  if (x > 0) {
    const b = 2;
  }
  return a;
}
--- right
export function run(): number {
  let x = 0;
  const a = 1;
  if (x > 0) {
    const b = 2;
    void b;
  }
  return a;
}
