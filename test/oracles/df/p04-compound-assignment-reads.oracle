# Right uses +=, which reads the value Left wrote.
--- expect
{"analyses":["df"],"alerts":[{"type":"DF","element":"x","first":"Left run","second":"Right run"}]}
--- base
export function run(): number {
  let x = 0;
  const a = 1;
  const b = 2;
  return a + b;
}
--- left
export function run(): number {
  let x = 0;
  x = 1;
  const a = 1;
  const b = 2;
  return a + b;
}
--- right
export function run(): number {
  let x = 0;
  const a = 1;
  const b = 2;
  x += 1;
  return a + b;
}
