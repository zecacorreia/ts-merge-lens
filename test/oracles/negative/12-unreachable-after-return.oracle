# Left writes only on a path that returns, so that write never reaches the Right write.
--- expect
{"alerts":[]}
--- base
export function run(c: boolean): number {
  let x = 0;
  const a = 1;
  const b = 2;
  return x + a + b;
}
--- left
export function run(c: boolean): number {
  let x = 0;
  if (c) {
    x = 1;
    return x;
  }
  const a = 1;
  const b = 2;
  return x + a + b;
}
--- right
export function run(c: boolean): number {
  let x = 0;
  const a = 1;
  const b = 2;
  x = 2;
  return x + a + b;
}
