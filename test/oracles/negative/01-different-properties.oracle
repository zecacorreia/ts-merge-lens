# p.x and p.y are different elements.
--- expect
{"alerts":[]}
--- base
interface Point {
  x: number;
  y: number;
}
export function run(p: Point): number {
  const a = 1;
  const b = 2;
  return p.y + a + b;
}
--- left
interface Point {
  x: number;
  y: number;
}
export function run(p: Point): number {
  p.x = 1;
  const a = 1;
  const b = 2;
  return p.y + a + b;
}
--- right
interface Point {
  x: number;
  y: number;
}
export function run(p: Point): number {
  const a = 1;
  const b = 2;
  p.y = 2;
  return p.y + a + b;
}
