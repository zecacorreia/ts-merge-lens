# Left writes an inner x that shadows the outer x written by Right (different symbols).
--- expect
{"alerts":[]}
--- base
export function run(): number {
  let x = 0;
  const a = 1;
  const b = 2;
  return a + b;
}
--- left
export function run(): number {
  let x = 0;
  {
    let x = 1;
    x = 2;
  }
  const a = 1;
  const b = 2;
  return a + b;
}
--- right
export function run(): number {
  let x = 0;
  const a = 1;
  const b = 2;
  x = 3;
  return a + b;
}
