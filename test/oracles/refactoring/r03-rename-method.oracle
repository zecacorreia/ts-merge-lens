--- left
export class Doc {
  v = 0;
  run(): number {
    const a = 1;
    this.increment();
    const b = 2;
    return a + b;
  }
  increment(): void {
    this.v = 1;
  }
}
--- right
export class Doc {
  v = 0;
  run(): number {
    const a = 1;
    this.bump();
    const b = 2;
    this.v = 2;
    return a + b;
  }
  bump(): void {
    this.v = 1;
  }
}
