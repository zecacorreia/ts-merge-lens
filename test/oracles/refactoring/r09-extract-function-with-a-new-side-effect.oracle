# Left extracts a method but the method also does something more: not a refactoring.
--- expect
{"byFilter":{"off":[{"element":"this.v","first":"Left Doc.setV","second":"Right Doc.run"}],"downgrade":[{"element":"this.v","first":"Left Doc.setV","second":"Right Doc.run"}],"suppress":[{"element":"this.v","first":"Left Doc.setV","second":"Right Doc.run"}]},"alerts":[{"element":"this.v","first":"Left Doc.setV","second":"Right Doc.run"}]}
--- base
export class Doc {
  v = 0;
  run(): number {
    const a = 1;
    this.v = 1;
    const b = 2;
    return a + b;
  }
}
--- left
export class Doc {
  v = 0;
  run(): number {
    const a = 1;
    this.setV();
    const b = 2;
    return a + b;
  }
  setV(): void {
    this.v = 1;
    this.v += 0;
  }
}
--- right
export class Doc {
  v = 0;
  run(): number {
    const a = 1;
    this.v = 1;
    const b = 2;
    this.v = 2;
    return a + b;
  }
}
