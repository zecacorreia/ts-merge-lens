# Left extracts a variable but also doubles the value: the change is not purely structural.
--- expect
{"byFilter":{"off":[{"element":"this.v","first":"Left Doc.run","second":"Right Doc.run"}],"downgrade":[{"element":"this.v","first":"Left Doc.run","second":"Right Doc.run"}],"suppress":[{"element":"this.v","first":"Left Doc.run","second":"Right Doc.run"}]},"alerts":[{"element":"this.v","first":"Left Doc.run","second":"Right Doc.run"}]}
--- base
export class Doc {
  v = 0;
  run(): number {
    const a = 1;
    const b = 2;
    this.v = a + b;
    const c = 3;
    return a + c;
  }
}
--- left
export class Doc {
  v = 0;
  run(): number {
    const a = 1;
    const b = 2;
    const sum = a + b;
    this.v = sum * 2;
    const c = 3;
    return a + c;
  }
}
--- right
export class Doc {
  v = 0;
  run(): number {
    const a = 1;
    const b = 2;
    this.v = a + b;
    const c = 3;
    this.v = 9;
    return a + c;
  }
}
