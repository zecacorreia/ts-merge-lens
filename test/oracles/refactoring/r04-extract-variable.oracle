--- left
export class Doc {
  v = 0;
  run(): number {
    const a = 1;
    const b = 2;
    const sum = a + b;
    this.v = sum;
    const c = 3;
    return a + c;
  }
}
--- right
export class Doc {
  v = 0;
  run(): number {
    const a = 1;
    const b = 2;
