--- left
export class Doc {
  v = 0;
  run(): number {
    const a = 1;
    const b = 2;
    this.v = a * b;
    const c = 3;
    return a + c;
  }
}
--- right
export class Doc {
  v = 0;
  run(): number {
    const a = 1;
    const b = 2;
    this.v = a + b;
    const c = 3;
    this.v = 9;
    return a + c;
  }
}
